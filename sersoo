:root {
  --bg: #f7f9fc;
  --white: #fff;
  --ink: #102033;
  --muted: #526174;
  --sub: #66768a;
  --line: #dbe3ec;
  --blue: #1f5eff;
  --blue2: #1746c5;
  --navy: #0c1b2a;
  --soft: #f2f6fa;
  --shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Inter, Arial, sans-serif;
  background: var(--bg);
  color: var(--ink);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1120px, calc(100% - 40px));
  margin: auto;
}

.progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 0;
  background: var(--blue);
  z-index: 2000;
}

header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.88);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(16px);
}

.nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.brand span {
  color: var(--blue);
}

.links {
  display: flex;
  gap: 30px;
  list-style: none;
}

.links a {
  color: #667085;
  font-size: 0.9rem;
  font-weight: 600;
  transition: 0.25s;
}

.links a:hover,
.links a.active {
  color: var(--ink);
}

.menu {
  display: none;
  border: 0;
  background: transparent;
  font-size: 1.5rem;
}

.eyebrow {
  color: var(--blue);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.hero {
  min-height: calc(100vh - 76px);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  border-radius: 50%;
  background: #dce9ff;
  filter: blur(90px);
  opacity: 0.6;
  right: -160px;
  top: -120px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  gap: 80px;
  align-items: center;
}

.hero h1 {
  font-size: clamp(3.2rem, 7vw, 6.2rem);
  line-height: 0.98;
  letter-spacing: -0.075em;
  margin-top: 20px;
}

.hero h1 em {
  color: var(--blue);
  font-style: normal;
}

.lead {
  max-width: 650px;
  margin-top: 27px;
  color: var(--muted);
  font-size: 1.08rem;
}

.lead strong {
  color: var(--ink);
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  padding: 0 21px;
  border-radius: 11px;
  font-size: 0.9rem;
  font-weight: 700;
  border: 1px solid transparent;
  transition: 0.25s;
}

.btn:hover {
  transform: translateY(-2px);
}

.primary {
  background: var(--blue);
  color: white;
  box-shadow: 0 10px 25px rgba(37, 99, 235, 0.18);
}

.primary:hover {
  background: var(--blue2);
}

.ghost {
  background: white;
  border-color: var(--line);
}

.ghost:hover {
  border-color: #b8c2d0;
}

.quick {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 27px;
  color: var(--sub);
  font-size: 0.8rem;
}

.quick a:hover {
  color: var(--blue);
}

.visual {
  min-height: 520px;
  display: grid;
  place-items: center;
  position: relative;
}

.portrait {
  width: min(390px, 90%);
  padding: 42px 32px 35px;
  background: var(--navy);
  color: white;
  border-radius: 28px;
  box-shadow: 0 35px 80px rgba(11, 18, 32, 0.22);
  text-align: center;
  position: relative;
  z-index: 2;
}

.photo {
  width: 190px;
  height: 190px;
  margin: 0 auto 25px;
  padding: 6px;
  border-radius: 50%;
  background: white;
  overflow: hidden;
}

.photo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 50%;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #cbd5e1;
  font-size: 0.76rem;
}

.status i {
  width: 7px;
  height: 7px;
  background: #60a5fa;
  border-radius: 50%;
}

.portrait h2 {
  margin-top: 13px;
  font-size: 1.7rem;
  line-height: 1.15;
}

.portrait p {
  color: #cbd5e1;
  margin-top: 12px;
  font-size: 0.84rem;
}

.chip {
  position: absolute;
  background: white;
  border: 1px solid var(--line);
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 0.75rem;
  box-shadow: var(--shadow);
  z-index: 3;
}

.one {
  left: 1%;
  top: 19%;
}

.two {
  right: 0;
  bottom: 19%;
}

.scroll {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  color: #98a2b3;
  font-size: 0.75rem;
}

.section {
  padding: 110px 0;
}

.muted {
  background: var(--soft);
}

.two {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 100px;
}

.heading h2 {
  font-size: clamp(2rem, 4vw, 3.3rem);
  line-height: 1.1;
  letter-spacing: -0.055em;
  margin-top: 16px;
}

.heading p {
  color: var(--muted);
  margin-top: 16px;
}

.centered {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 52px;
}

.copy {
  color: var(--muted);
  font-size: 1.02rem;
}

.copy p + p {
  margin-top: 18px;
}

.facts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-top: 35px;
}

.facts div {
  border-top: 1px solid var(--line);
  padding-top: 16px;
}

.facts strong {
  display: block;
  font-size: 1.5rem;
}

.facts span {
  color: var(--sub);
  font-size: 0.75rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.card,
.project {
  background: white;
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 28px;
  transition: 0.25s;
}

.card {
  min-height: 190px;
}

.card:hover,
.project:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
}

.card small,
.project small {
  color: #98a2b3;
  font-weight: 800;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
}

.card h3 {
  margin-top: 25px;
}

.card p,
.project p {
  color: var(--muted);
  margin-top: 7px;
  font-size: 0.86rem;
}

.projects {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 18px;
}

.project {
  min-height: 300px;
}

.project h3 {
  margin-top: 75px;
  font-size: clamp(1.5rem, 3vw, 2rem);
  letter-spacing: -0.04em;
}

.project.dark {
  background: var(--navy);
  color: white;
  border-color: var(--navy);
}

.project.dark p {
  color: #cbd5e1;
}

.tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 24px;
}

.tags span {
  padding: 6px 9px;
  border-radius: 7px;
  background: #eef4ff;
  color: #1746c5;
  font-size: 0.7rem;
  font-weight: 700;
}

.project.dark .tags span {
  background: rgba(96, 165, 250, 0.12);
  color: #bfdbfe;
}

.timeline {
  max-width: 850px;
  margin: auto;
  border-left: 1px solid #cbd5e1;
}

.timeline article {
  display: grid;
  grid-template-columns: 170px 1fr;
  gap: 30px;
  padding: 0 0 35px 28px;
  position: relative;
}

.timeline article::before {
  content: "";
  position: absolute;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--blue);
  left: -5px;
  top: 6px;
}

.timeline b {
  color: var(--blue);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
}

.timeline p {
  color: var(--muted);
  font-size: 0.86rem;
}

.cert {
  margin-top: 35px;
  padding: 32px;
  border: 1px solid var(--line);
  background: white;
  border-radius: 20px;
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 30px;
}

.cert h3 {
  margin-top: 8px;
}

.cert ul {
  list-style: none;
  color: var(--muted);
  display: grid;
  gap: 10px;
}

.cert li::before {
  content: "✓";
  color: var(--blue);
  font-weight: 800;
  margin-right: 10px;
}

.contact {
  background: var(--navy);
  color: white;
  padding: 110px 0;
}

.contact-inner {
  text-align: center;
  max-width: 820px;
}

.contact .eyebrow {
  color: #60a5fa;
}

.contact h2 {
  font-size: clamp(2.4rem, 5vw, 4.5rem);
  line-height: 1;
  letter-spacing: -0.06em;
  margin-top: 18px;
}

.contact p {
  color: #cbd5e1;
  max-width: 620px;
  margin: 22px auto 30px;
}

.contact .quick {
  justify-content: center;
  color: #cbd5e1;
}

footer {
  background: #070c15;
  color: #98a2b3;
}

.foot {
  min-height: 75px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.78rem;
}

.foot a:hover {
  color: white;
}

.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.7s, transform 0.7s;
}

.reveal.visible {
  opacity: 1;
  transform: none;
}

@media (max-width: 900px) {
  .hero-grid,
  .two,
  .projects {
    grid-template-columns: 1fr;
  }

  .hero-grid {
    gap: 45px;
  }

  .visual {
    min-height: 460px;
  }

  .grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .two {
    gap: 45px;
  }

  .scroll {
    display: none;
  }
}

@media (max-width: 680px) {
  .container {
    width: calc(100% - 28px);
  }

  .section,
  .contact {
    padding: 80px 0;
  }

  .menu {
    display: block;
  }

  .links {
    position: fixed;
    inset: 76px 0 auto 0;
    background: white;
    padding: 25px;
    display: grid;
    gap: 18px;
    transform: translateY(-140%);
    transition: 0.25s;
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
  }

  .links.open {
    transform: translateY(0);
  }

  .hero {
    min-height: auto;
    padding: 75px 0;
  }

  .hero h1 {
    font-size: clamp(3rem, 15vw, 4.5rem);
  }

  .visual {
    min-height: 430px;
  }

  .chip {
    display: none;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .facts {
    grid-template-columns: 1fr;
  }

  .timeline article {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .cert {
    grid-template-columns: 1fr;
  }

  .foot {
    flex-direction: column;
    justify-content: center;
    gap: 7px;
  }
}
